[Unit]
Description=Reeframe VMS Daemon
Documentation=https://github.com/reetmlabs/reeframe-backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=reeframe
Group=reeframe

# Drop secrets into this file (mode 0600, owned by root) rather than
# embedding them in the unit file.  Lines are KEY=VALUE, one per line.
# Minimum required:
#   VMS_ENCRYPTION_KEY=<base64-encoded 32 bytes>
#   VMS_AUTH__JWT_SECRET=<base64-encoded 32 bytes>
#
# Generate with: openssl rand -base64 32 | sudo tee -a /etc/reeframe/env
EnvironmentFile=-/etc/reeframe/env

# GStreamer loads plugins from this folder before the system ones; the Ubuntu
# package ships its own gst-libav there. The registry cache is kept with the
# data, since the service account has no home directory.
Environment=GST_PLUGIN_PATH=/usr/lib/reeframe/gstreamer-1.0
Environment=GST_REGISTRY_1_0=/var/lib/reeframe/gstreamer-registry.bin
# Fontconfig (watermark text) needs a writable cache directory too.
Environment=XDG_CACHE_HOME=/var/lib/reeframe/.cache

ExecStart=/usr/local/bin/vms-daemon

Restart=on-failure
RestartSec=5s

# ── Logging ───────────────────────────────────────────────────────────────────
# Structured JSON logs go to stderr; journald captures them automatically.
# Adjust verbosity with VMS_LOG_LEVEL= in /etc/reeframe/env. RUST_LOG= overrides it.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reeframe

# ── Security hardening ────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true

# The filesystem is read-only except for the recording/DB directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/reeframe
# The default database (./reeframe.db) is created here; the rest of the
# filesystem is read-only under ProtectSystem=strict.
WorkingDirectory=/var/lib/reeframe

# No access to other users' home directories.
ProtectHome=true

# Prevent the process from gaining new capabilities.
CapabilityBoundingSet=

# Restrict to common address families only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
