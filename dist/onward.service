[Unit]
Description=OneWard VMS Daemon
Documentation=https://github.com/yourorg/onward-vms
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=onward
Group=onward

# Drop secrets into this file (mode 0600, owned by root) rather than
# embedding them in the unit file.  Lines are KEY=VALUE, one per line.
# Minimum required:
#   VMS_ENCRYPTION_KEY=<base64-encoded 32 bytes>
#
# Generate with: openssl rand -base64 32 | sudo tee -a /etc/onward/env
EnvironmentFile=-/etc/onward/env

ExecStart=/usr/local/bin/vms-daemon

Restart=on-failure
RestartSec=5s

# ── Logging ───────────────────────────────────────────────────────────────────
# Structured JSON logs go to stderr; journald captures them automatically.
# Adjust verbosity with RUST_LOG= in /etc/onward/env.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=onward

# ── Security hardening ────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true

# The filesystem is read-only except for the recording/DB directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/onward

# No access to other users' home directories.
ProtectHome=true

# Prevent the process from gaining new capabilities.
CapabilityBoundingSet=

# Restrict to common address families only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
