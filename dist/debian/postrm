#!/bin/bash
set -e

case "$1" in
    remove)
        # Stop and disable the service; leave data and config intact so an
        # accidental removal does not destroy recordings.
        if [ -d /run/systemd/system ]; then
            systemctl stop    reeframe.service > /dev/null 2>&1 || true
            systemctl disable reeframe.service > /dev/null 2>&1 || true
            systemctl daemon-reload
        fi
        ;;

    purge)
        # Full removal requested: stop the service and remove data, config and the user.
        if [ -d /run/systemd/system ]; then
            systemctl stop    reeframe.service > /dev/null 2>&1 || true
            systemctl disable reeframe.service > /dev/null 2>&1 || true
            systemctl daemon-reload
        fi

        rm -rf /var/lib/reeframe
        rm -rf /etc/reeframe

        if getent passwd reeframe > /dev/null 2>&1; then
            userdel reeframe
        fi
        if getent group reeframe > /dev/null 2>&1; then
            groupdel reeframe
        fi
        ;;
esac

exit 0
