#!/bin/bash
set -e

case "$1" in
    configure)
        # ── Create service account ─────────────────────────────────────────────
        if ! getent group reeframe > /dev/null 2>&1; then
            groupadd --system reeframe
        fi

        if ! getent passwd reeframe > /dev/null 2>&1; then
            useradd \
                --system \
                --gid reeframe \
                --no-create-home \
                --shell /usr/sbin/nologin \
                --comment "Reeframe VMS daemon" \
                reeframe
        fi

        # ── Create data and config directories ────────────────────────────────
        install -d -m 0750 -o reeframe -g reeframe /var/lib/reeframe
        install -d -m 0750 -o reeframe -g reeframe /var/lib/reeframe/recordings

        # Create /etc/reeframe and a stub env file if neither exists yet.
        # The stub is root-only (0600) so secrets written into it are not
        # world-readable.
        install -d -m 0755 /etc/reeframe
        if [ ! -f /etc/reeframe/env ]; then
            cat > /etc/reeframe/env <<'EOF'
# Reeframe VMS environment — loaded by systemd before starting the daemon.
# Protect this file: chmod 600 /etc/reeframe/env

# REQUIRED — generate each with: openssl rand -base64 32
# VMS_ENCRYPTION_KEY=
# VMS_AUTH__JWT_SECRET=

# Optional overrides (built-in defaults shown):
# VMS_DATABASE__URL=sqlite:///var/lib/reeframe/reeframe.db
# VMS_MEDIA__RECORDING_DIR=/var/lib/reeframe/recordings
# VMS_API__BIND=0.0.0.0:8080
# VMS_RTSP__BIND=0.0.0.0:8554
# RUST_LOG=info
EOF
            chmod 0600 /etc/reeframe/env
        fi

        # ── Enable and start the service ──────────────────────────────────────
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable reeframe.service
            # Only start automatically on first install, not on upgrade.
            if [ -z "$2" ]; then
                systemctl start reeframe.service || true
            fi
        fi
        ;;
esac

exit 0
