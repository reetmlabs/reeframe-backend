#!/bin/bash
set -e

case "$1" in
    configure)
        # ── Create service account ─────────────────────────────────────────────
        if ! getent group reeframe > /dev/null 2>&1; then
            groupadd --system reeframe
        fi

        if ! getent passwd reeframe > /dev/null 2>&1; then
            useradd \
                --system \
                --gid reeframe \
                --no-create-home \
                --shell /usr/sbin/nologin \
                --comment "Reeframe VMS daemon" \
                reeframe
        fi

        # ── Create data and config directories ────────────────────────────────
        install -d -m 0750 -o reeframe -g reeframe /var/lib/reeframe
        install -d -m 0750 -o reeframe -g reeframe /var/lib/reeframe/recordings

        # Create /etc/reeframe and a stub env file if neither exists yet.
        # The stub is root-only (0600) so secrets written into it are not
        # world-readable.
        install -d -m 0755 /etc/reeframe
        if [ ! -f /etc/reeframe/env ]; then
            cat > /etc/reeframe/env <<'EOF'
# Reeframe environment, loaded by systemd before the daemon starts.
# Protect this file: chmod 600 /etc/reeframe/env

# Required. Generate each with: openssl rand -base64 32
# VMS_ENCRYPTION_KEY=
# VMS_AUTH__JWT_SECRET=

# Optional overrides (built-in defaults shown):
# VMS_DATABASE__URL=sqlite:///var/lib/reeframe/reeframe.db?mode=rwc
# VMS_MEDIA__RECORDING_DIR=/var/lib/reeframe/recordings
# VMS_API__BIND=0.0.0.0:8080
# VMS_RTSP__BIND=0.0.0.0:8554
# VMS_LOG_LEVEL=info
EOF
            chmod 0600 /etc/reeframe/env
        fi

        # Up to 0.2.0 the unit was in /etc/systemd/system. Its enable link is
        # left dangling once dpkg removes that file, so drop it.
        old_link=/etc/systemd/system/multi-user.target.wants/reeframe.service
        if [ -L "$old_link" ] && [ "$(readlink "$old_link")" = /etc/systemd/system/reeframe.service ]; then
            rm -f "$old_link"
        fi

        # ── Enable and start the service ──────────────────────────────────────
        # A service that can't start never fails the install; it prints what
        # to do instead.
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl enable reeframe.service || true
            missing=""
            for key in VMS_ENCRYPTION_KEY VMS_AUTH__JWT_SECRET; do
                grep -Eq "^[[:space:]]*${key}=[^[:space:]]" /etc/reeframe/env || missing="$missing $key"
            done
            if [ -n "$missing" ]; then
                echo "reeframe: not starting the service, /etc/reeframe/env has no value for:$missing"
                echo "reeframe: set them (openssl rand -base64 32), then run: systemctl restart reeframe.service"
            elif ! systemctl restart reeframe.service || ! { sleep 3; systemctl is-active --quiet reeframe.service; }; then
                echo "reeframe: the service did not start, see: journalctl -u reeframe.service"
            fi
        fi
        ;;
esac

exit 0
